model Rma {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero_rma             String                   @unique
  orden_id               String?                  @db.Uuid
  devolucion_venta_id    String?                  @db.Uuid
  garantia_id            String?                  @db.Uuid
  orden_servicio_id      String?                  @db.Uuid
  cliente_id             String                   @db.Uuid
  producto_id            String                   @db.Uuid
  serial_producto        String?
  tipo_rma               TipoRma
  motivo                 String
  prioridad              Prioridad                @default(normal)
  estado                 EstadoRma                @default(pendiente)
  deposito_recepcion_id  String?                  @db.Uuid
  usuario_crea_id        String                   @db.Uuid
  usuario_responsable_id String?                  @db.Uuid
  fecha_recepcion        DateTime?                @db.Timestamptz(6)
  diagnostico            String?
  resultado_diagnostico  ResultadoDiagnosticoRma?
  resolucion             ResolucionRma?
  producto_reemplazo_id  String?                  @db.Uuid
  serial_reemplazo       String?
  monto_reembolso        Decimal?
  caja_movimiento_id     String?                  @db.Uuid
  fecha_cierre           DateTime?                @db.Timestamptz(6)
  usuario_cierra_id      String?                  @db.Uuid
  observaciones          String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)

  orden              Orden?           @relation("RmaOrden", fields: [orden_id], references: [id])
  devolucionVenta    DevolucionVenta? @relation("RmaDevVenta", fields: [devolucion_venta_id], references: [id])
  garantia           Garantia?        @relation("RmaGarantia", fields: [garantia_id], references: [id])
  ordenServicio      OrdenServicio?   @relation("RmaOrdenServicio", fields: [orden_servicio_id], references: [id])
  cliente            Cliente          @relation("RmaCliente", fields: [cliente_id], references: [id])
  producto           Producto         @relation("RmaProducto", fields: [producto_id], references: [id])
  depositoRecepcion  Deposito?        @relation("RmaDepositoRecepcion", fields: [deposito_recepcion_id], references: [id])
  usuarioCrea        Usuario          @relation("RmaCreador", fields: [usuario_crea_id], references: [id])
  usuarioResponsable Usuario?         @relation("RmaResponsable", fields: [usuario_responsable_id], references: [id])
  productoReemplazo  Producto?        @relation("RmaProductoReemplazo", fields: [producto_reemplazo_id], references: [id])
  cajaMovimiento     CajaMovimiento?  @relation("RmaCajaMovimiento", fields: [caja_movimiento_id], references: [id])
  usuarioCierra      Usuario?         @relation("RmaCerrador", fields: [usuario_cierra_id], references: [id])

  documentos RmaDocumento[] @relation("RmaDocumentos")

  @@map("rmas")
}


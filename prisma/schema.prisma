  cotizacionesModificadas       Cotizacion[]           @relation("CotizacionModificador")
  devolucionesCompraCreadas     DevolucionCompra[]     @relation("DevCompraCreador")
  devolucionesCompraModificadas DevolucionCompra[]     @relation("DevCompraModificador")
  devolucionesVentasCreadas     DevolucionVenta[]      @relation("DevVentaCreador")
  devolucionesVentasModificadas DevolucionVenta[]      @relation("DevVentaModificador")
  pagosClientesCreados          PagoCliente[]          @relation("PagoClienteCreador")
  pagosClientesModificados      PagoCliente[]          @relation("PagoClienteModificador")
  pagosProveedoresCreados       PagoProveedor[]        @relation("PagoProveedorCreador")
  pagosProveedoresModificados   PagoProveedor[]        @relation("PagoProveedorModificador")
  ticketsCreados                TicketSoporte[]        @relation("TicketUsuario")
  importacionesPegasus          ImportacionPegasus[]   @relation("ImportacionUsuario")
  eliminacionesOrdenes          EliminacionOrden[]     @relation("EliminacionUsuario")
  actividadLogs                 ActividadLog[]         @relation("ActividadUsuario")
  ajustesStockCreados           AjusteStock[]          @relation("AjusteStockUsuario")
  ajustesStockAprobados         AjusteStock[]          @relation("AjusteStockAprobador")
  recepcionesCompraUsuario      RecepcionCompra[]      @relation("RecepcionUsuario")
  recepcionesCompraAprobadas    RecepcionCompra[]      @relation("RecepcionAprobador")
  ingresosStockCompra           IngresoStockCompra[]   @relation("IngresoStockUsuario")
  rmasCreados                   Rma[]                  @relation("RmaCreador")
  rmasResponsable               Rma[]                  @relation("RmaResponsable")
  rmasCerrados                  Rma[]                  @relation("RmaCerrador")
  notificaciones                Notificacion[]         @relation("NotificacionUsuario")

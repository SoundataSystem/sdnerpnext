// ─── Eventos de dominio (Outbox Pattern) ──────────────────────────────────────
/**
 * Outbox para eventos de dominio (Pattern: Transactional Outbox).
 * Garantiza que cada operación crítica genere un evento publicable
 * dentro de la MISMA transacción que la operación de negocio.
 * Un worker posterior procesa el outbox y publica a message broker / webhooks.
 */
model EventoOutbox {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /** Tipo de evento de dominio (ej: "venta.creada", "cobro.registrado", "stock.ajustado") */
  tipo             String
  /** Identificador de correlación para tracing distribuido */
  correlation_id   String
  /** Actor que originó el evento */
  actor_id         String?         @db.Uuid
  actor_nombre     String?
  actor_rol        String?
  /** Entidad afectada */
  entidad          String
  entidad_id       String
  /** Datos antes/después del cambio */
  datos_anteriores Json?
  datos_nuevos     Json?
  /** Metadata adicional (request_id, user_agent, ip, etc.) */
  metadata         Json?
  /** Estado de procesamiento */
  estado           EstadoEventoOutbox @default(PENDIENTE)
  /** Intentos de procesamiento */
  intentos         Int             @default(0)
  /** Error del último intento (si falló) */
  ultimo_error     String?
  /** Fecha de creación (en transacción original) */
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  /** Fecha de último intento de procesamiento */
  procesado_en     DateTime?

  @@index([estado, created_at])
  @@index([correlation_id])
  @@index([entidad, entidad_id])
  @@map("eventos_outbox")
}

enum EstadoEventoOutbox {
  PENDIENTE
  PROCESANDO
  PROCESADO
  FALLIDO
  DESCARTADO
}

// ─── Idempotencia ─────────────────────────────────────────────────────────────
/**
 * Claves de idempotencia para operaciones críticas.
 * Garantiza que operaciones repetidas no causen efectos duplicados.
 */
model IdempotenciaClave {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave       String   @unique
  tipo        String
  entidadId   String   @map("entidad_id")
  entidadTipo String   @map("entidad_tipo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tipo])
  @@index([entidadTipo, entidadId])
  @@map("idempotencia_claves")
}

